# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Postgres connection string. Matches infrastructure/docker-compose.yml defaults.
# Host port is 5433 (not 5432) to avoid colliding with other local Postgres instances.
DATABASE_URL=postgresql://karate:karate_dev_password@localhost:5433/karate_dev?schema=public

# Optional — enables realtime/caching foundations once wired up.
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32 (must be >= 32 characters)
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string-before-first-run
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

CORS_ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=debug

# Parent SportsHub identity integration boundary — leave unset until available.
SPORTSHUB_API_BASE_URL=
SPORTSHUB_API_KEY=
