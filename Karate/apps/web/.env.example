# Copy to .env.local for local development.

# Backend API base URL, called server-side only (Route Handlers, Server Components).
API_BASE_URL=http://localhost:4000

# Browser Socket.IO origin. Must be set to the public API origin in staging/production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Must be IDENTICAL to apps/api's JWT_ACCESS_SECRET — this app verifies the
# same access tokens the API issues, it does not issue its own.
JWT_ACCESS_SECRET=replace-with-the-same-value-as-apps-api-JWT_ACCESS_SECRET

# LordOfCricket API for shared logout (server-side). Same value as the API.
CRICKET_API_URL=http://localhost:5000/api

# LordOfSportz hub URL (link back to all sports). Dev fallback: http://localhost:3000
NEXT_PUBLIC_HUB_URL=

# Shared identity web URL for account creation (dev fallback http://localhost:5173)
NEXT_PUBLIC_CRICKET_WEB_URL=
