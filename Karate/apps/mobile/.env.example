# Copy to .env for local development (Expo reads EXPO_PUBLIC_* at build/bundle time).
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
# Android emulator: use http://10.0.2.2:4000 (or run: adb reverse tcp:4000 tcp:4000 and keep localhost).

# Shared identity (LordOfCricket). Dev over `adb reverse tcp:5000 tcp:5000`:
# EXPO_PUBLIC_CRICKET_API_URL=http://localhost:5000/api
# EXPO_PUBLIC_CRICKET_WEB_URL=http://10.0.2.2:5173   (account creation)
# EXPO_PUBLIC_CRICKET_APP_URL=loc-mobile://          (Expo Go dev: exp://localhost:8081/--/)
