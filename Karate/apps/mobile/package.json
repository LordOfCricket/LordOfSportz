{
  "name": "@karate/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "React Native (Expo Router) mobile application for players, coaches, academies, and scorers.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@karate/constants": "workspace:*",
    "@karate/types": "workspace:*",
    "@karate/validation": "workspace:*",
    "expo": "~57.0.24",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "^0.10.1",
    "socket.io-client": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^20.16.5",
    "@types/react": "^19.2.18",
    "babel-preset-expo": "~57.0.12",
    "typescript": "^6.0.3"
  }
}
