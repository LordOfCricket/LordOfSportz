# ── Local development ──────────────────────────────────────────────
# Android emulator reaches the Windows host on 10.0.2.2; iOS simulator
# and web use localhost. The backend dev server listens on port 5000.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
EXPO_PUBLIC_APP_ENV=development

# ── Production / preview (do NOT commit real values) ───────────────
# EXPO_PUBLIC_API_URL must be the real HTTPS API origin, for example
#   EXPO_PUBLIC_API_URL=https://<api-host>/api
# In a non-development build a missing or non-https value throws at
# startup (see src/services/api.ts) instead of falling back to localhost.
#
# EXPO_PUBLIC_APP_ENV must be any non-development value (e.g. production
# or preview). These are injected per EAS build profile (eas.json) or
# via `eas env` / EAS dashboard secrets — never checked in.

# Deep-link base of the Karate app for cross-app sign-in (release: karateplatform://; Expo Go dev: exp://localhost:8082/--/)
# EXPO_PUBLIC_KARATE_APP_URL=karateplatform://
