PORT=5000
NODE_ENV=production
# Comma-separated list of origins allowed to call this API (no trailing slashes)
CLIENT_ORIGIN=http://localhost:5173,https://lordofcricket.com,https://www.lordofcricket.com
CRICAPI_KEY=

# Set to "1" only when the server sits behind a real reverse proxy
# (Nginx/Render/Railway/etc) that sets X-Forwarded-For. Controls rate-limit
# and logging IP attribution — leave unset for local dev and any deployment
# that terminates TLS on this process directly, otherwise a client could
# spoof its own IP via that header and bypass rate limiting entirely.
TRUST_PROXY=

# Postgres (LOC)
PG_USER=
PG_HOST=
PG_DATABASE=
PG_PASSWORD=
PG_PORT=
# Max connections in the pool (optional — pg's own default is 10, same value
# used if unset; only set this if you've actually measured pool exhaustion).
PG_POOL_MAX=

# Prisma (Phase 2A) — same Postgres instance as PG_* above, expressed as one
# connection string because that's what Prisma's datasource block requires.
# The pre-existing `pg` Pool in config/db.js is untouched and keeps reading
# the discrete PG_* vars above; DATABASE_URL is additive, only consumed by
# prisma/schema.prisma and the new Prisma client module. Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Auth — legacy email+password login, kept alive during the Phase 3 OTP
# migration window (see docs/AUTH.md). Used to sign login sessions (set a
# long random value in production)
JWT_SECRET=

# Auth — Phase 3 unified OTP login (email or phone), the new primary path.
# Session cookie signing secret — separate from JWT_SECRET so the two auth
# mechanisms don't share a compromise. Long random value in production;
# server refuses to boot in production without it (same fail-fast pattern
# as JWT_SECRET — see utils/session.js).
SESSION_COOKIE_SECRET=
# All four below have sane defaults if unset (see services/otp.service.js) —
# only set these if you need to deviate from the defaults.
OTP_LENGTH=
OTP_TTL_MINUTES=
OTP_MAX_ATTEMPTS=
OTP_RESEND_COOLDOWN_SECONDS=
SESSION_TTL_DAYS=

# Auth — Twilio Verify (phone OTP delivery), Standard API Key auth (not the
# Account Auth Token). All four required together to use real Twilio; if any
# is unset, the console provider is used instead (logs the OTP server-side
# only — never sends a real SMS). Never exposed to the frontend.
# TWILIO_ACCOUNT_SID: starts with AC, from the Twilio Console.
# TWILIO_API_KEY / TWILIO_API_SECRET: a Standard API Key (SID starts with SK)
#   created under Account > API keys & tokens — not the Auth Token.
# TWILIO_VERIFY_SERVICE_SID: the Verify Service SID (starts with VA).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=

# Auth — SendGrid (email OTP delivery). Both required together to use real
# SendGrid; if either is unset, the console provider is used instead (logs
# the OTP server-side only — never sends a real email). Never exposed to the
# frontend.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Auth — Phase 6 privileged-account MFA (WebAuthn passkeys + TOTP fallback,
# SUPER_ADMIN/GROUND_OWNER only). RP ID is the bare domain (no scheme/port)
# the passkey is bound to — a passkey registered for one RP ID will never
# work on another, by design (this is WebAuthn's own anti-phishing
# guarantee, not something LOC enforces itself). WEBAUTHN_ORIGIN is the
# comma-separated list of exact origins (scheme + host + port) allowed to
# complete a ceremony — mirrors CLIENT_ORIGIN's shape. All three are
# required in production; local dev falls back to localhost values if unset
# (see services/mfaState.service.js).
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Lord Of Cricket
WEBAUTHN_ORIGIN=
# All three below have sane defaults if unset (see services/mfaState.service.js
# and services/stepUp.service.js) — only set to deviate from the defaults.
MFA_VERIFIED_TTL_MINUTES=
STEP_UP_TTL_MINUTES=
WEBAUTHN_CHALLENGE_TTL_MINUTES=
# AES-256-GCM key encrypting TOTP secrets at rest — base64, must decode to
# exactly 32 bytes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reused from JWT_SECRET/SESSION_COOKIE_SECRET — a compromise of one
# auth secret must not also expose enrolled TOTP secrets.
MFA_ENCRYPTION_KEY=
# NOTE: MFA/step-up enforcement itself is currently disabled at the code
# level (see docs/MFA.md status banner) — this key is still required
# because TOTP secrets are still encrypted at rest for any factor a user
# enrolls, even though enrollment is no longer required.
MFA_DEV_BYPASS=

# Canteen — Cloudinary (for menu item images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Ground Booking — the ground's operating policy (all optional, sensible
# defaults in server/src/domain/booking/policy.js if unset)
GROUND_TIMEZONE=Asia/Kolkata
GROUND_OPENING_HOUR=6
GROUND_CLOSING_HOUR=22
GROUND_SLOT_DURATION_MINUTES=120
GROUND_BOOKING_HORIZON_DAYS=60

# Ground Booking — Google Calendar sync (optional; booking works fully
# without it — see docs/ARCHITECTURE.md's Phase 14 section). A SERVICE
# ACCOUNT for the ground's own operational calendar, never a customer's
# personal OAuth. GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY must keep its literal
# "\n" sequences (paste the PEM as one line) — they're unescaped at runtime.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# AI Insight (Phase 16) — optional; the server boots and every existing page
# works fully without it (see docs/ARCHITECTURE.md's Phase 16 section).
# AI_PROVIDER currently supports only 'anthropic'. Never expose these to the
# React client — every AI request originates from the backend only.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# MongoDB — MIGRATION TOOLING ONLY (MongoDB cleanup, Phase 6). Not read by
# normal `npm run dev`/`npm start` — server.js no longer connects to MongoDB
# at boot. Every live feature (gallery, AI insight cache, canteen menu/
# today's menu/orders) is PostgreSQL-backed as of Phases 1-5. Only needed if
# you're running `npm run migrate:*` / `npm run backup:mongo` against a
# pre-Phase-6 MongoDB database, or a rollback-path integration test.
MONGO_URI=mongodb://localhost:27017/loc-v1
