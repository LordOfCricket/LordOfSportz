  users_ground_bookings_user_idTousers             users?                 @relation("ground_bookings_user_idTousers", fields: [user_id], references: [id], onUpdate: NoAction)
  ground_notifications                             ground_notifications[]

  @@index([start_time], map: "idx_ground_bookings_start_time")
  @@index([user_id], map: "idx_ground_bookings_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ground_notifications {
