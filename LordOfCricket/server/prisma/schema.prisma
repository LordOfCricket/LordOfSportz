generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model advertisements {
  id         Int      @id @default(autoincrement())
  title      String?  @db.VarChar(150)
  image_url  String
  link_url   String?
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_insights {
  id                 Int      @id @default(autoincrement())
  source_type        String   @db.VarChar(10)
  source_id          String   @db.VarChar(30)
  source_fingerprint String   @db.VarChar(64)
  provider           String   @db.VarChar(30)
  model              String   @db.VarChar(50)
  payload            Json
  generated_at       DateTime @default(now()) @db.Timestamptz(6)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)
  legacy_mongo_id    String?

  @@unique([source_type, source_id])
}

model amenities {
  id                   Int      @id @default(autoincrement())
  name                 String   @db.VarChar(100)
  image_url            String
  sort_order           Int      @default(0)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  cloudinary_public_id String?
  ground_id            Int
  grounds              grounds  @relation(fields: [ground_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ground_id], map: "idx_amenities_ground_id")
}

model canteens {
  id                Int          @id @default(autoincrement())
  ground_id         Int
  public_canteen_id String       @unique @db.VarChar(20)
  name              String       @default("Main Canteen") @db.VarChar(150)
  is_active         Boolean      @default(true)
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @default(now()) @db.Timestamptz(6)
  grounds           grounds      @relation(fields: [ground_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu_items        menu_items[]
  orders            orders[]
  today_menu        today_menu?

  @@index([ground_id], map: "idx_canteens_ground_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model commentary_entries {
  id                 BigInt        @id @default(autoincrement())
  match_id           Int
  innings_id         Int
  entry_key          String        @db.VarChar(80)
  sequence           Int
  type               String        @db.VarChar(20)
  source_delivery_id BigInt?
  source_event_id    BigInt?
  over_number        Int?          @db.SmallInt
  ball_in_over       Int?          @db.SmallInt
  ball_label         String?       @db.VarChar(10)
  text               String
  tags               Json          @default("[]")
  score_runs         Int?
  score_wickets      Int?          @db.SmallInt
  innings_version    Int
  created_at         DateTime      @default(now()) @db.Timestamp(6)
  updated_at         DateTime      @default(now()) @db.Timestamp(6)
  innings            innings       @relation(fields: [innings_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  matches            matches       @relation(fields: [match_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deliveries         deliveries?   @relation(fields: [source_delivery_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  match_events       match_events? @relation(fields: [source_event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([innings_id, entry_key])
  @@index([innings_id, sequence], map: "idx_commentary_entries_innings_seq")
  @@index([match_id, sequence], map: "idx_commentary_entries_match")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model deliveries {
  id                                                                  BigInt               @id @default(autoincrement())
  innings_id                                                          Int
  log_sequence                                                        Int
  recorded_by_user_id                                                 Int?
  client_action_id                                                    String?              @db.Uuid
  is_dead_ball                                                        Boolean              @default(false)
  bat_runs                                                            Int                  @default(0) @db.SmallInt
  illegal_type                                                        String?              @db.VarChar(10)
  illegal_runs                                                        Int?                 @db.SmallInt
  extra_type                                                          String?              @db.VarChar(10)
  extra_runs                                                          Int?                 @db.SmallInt
  swap_striker_non_striker                                            Boolean              @default(false)
  bowler_match_player_id                                              Int
  voided                                                              Boolean              @default(false)
  created_at                                                          DateTime             @default(now()) @db.Timestamp(6)
  updated_at                                                          DateTime             @default(now()) @db.Timestamp(6)
  over_number                                                         Int?                 @db.SmallInt
  ball_in_over                                                        Int?                 @db.SmallInt
  striker_match_player_id                                             Int?
  non_striker_match_player_id                                         Int?
  is_legal_delivery                                                   Boolean?
  is_free_hit                                                         Boolean?
  total_runs                                                          Int?                 @db.SmallInt
  commentary_entries                                                  commentary_entries[]
  match_players_deliveries_bowler_match_player_idTomatch_players      match_players        @relation("deliveries_bowler_match_player_idTomatch_players", fields: [bowler_match_player_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  innings                                                             innings              @relation(fields: [innings_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  match_players_deliveries_non_striker_match_player_idTomatch_players match_players?       @relation("deliveries_non_striker_match_player_idTomatch_players", fields: [non_striker_match_player_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                                               users?               @relation(fields: [recorded_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  match_players_deliveries_striker_match_player_idTomatch_players     match_players?       @relation("deliveries_striker_match_player_idTomatch_players", fields: [striker_match_player_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  match_events                                                        match_events[]
  wagon_wheel_shots                                                   wagon_wheel_shots?
  wickets                                                             wickets?

  @@unique([innings_id, log_sequence])
  @@index([bowler_match_player_id], map: "idx_deliveries_bowler")
  @@index([striker_match_player_id], map: "idx_deliveries_striker")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model gallery_images {
  id                   Int      @id @default(autoincrement())
  title                String   @db.VarChar(150)
  description          String   @default("") @db.VarChar(500)
  category             String   @default("ground") @db.VarChar(20)
  image_url            String
  cloudinary_public_id String
  image_width          Int?
  image_height         Int?
  image_format         String?  @db.VarChar(10)
  image_bytes          Int?
  sort_order           Int      @default(0)
  is_active            Boolean  @default(true)
  created_by           Int?
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @db.Timestamptz(6)
  legacy_mongo_id      String?
  users                users?   @relation(fields: [created_by], references: [id], onUpdate: NoAction)

  @@index([category, is_active, sort_order], map: "idx_gallery_images_category_active_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ground_audit_log {
  id             Int      @id @default(autoincrement())
  entity_type    String   @db.VarChar(20)
  entity_id      Int
  action         String   @db.VarChar(30)
  actor_user_id  Int?
  previous_value Json?
  new_value      Json?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  users          users?   @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)

  @@index([entity_type, entity_id, created_at(sort: Desc)], map: "idx_ground_audit_log_entity")
